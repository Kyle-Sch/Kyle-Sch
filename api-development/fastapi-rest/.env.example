# .env.example
# Copy to .env and fill in values for local development.
# In AKS, set both AZURE_KEYVAULT_*_URI vars — all other secrets come from the vaults.

# ---------------------------------------------------------------------------
# Internal Key Vault — infrastructure secrets written by Terraform
# Terraform output: keyvault_internal_uri
# ---------------------------------------------------------------------------
AZURE_KEYVAULT_INTERNAL_URI=https://kv-int-YOUR-CLUSTER-NAME.vault.azure.net/

# ---------------------------------------------------------------------------
# External Key Vault — 3rd-party and pipeline-managed secrets
# Terraform output: keyvault_external_uri
# ---------------------------------------------------------------------------
AZURE_KEYVAULT_EXTERNAL_URI=https://kv-ext-YOUR-CLUSTER-NAME.vault.azure.net/

# ---------------------------------------------------------------------------
# Local dev fallbacks — used when EITHER KV URI above is NOT set
# ---------------------------------------------------------------------------

# External KV secrets
API_KEY=dev-insecure-key-change-me

# Internal KV secrets
AI_SEARCH_ENDPOINT=https://srch-YOUR-CLUSTER-NAME.search.windows.net
AI_SEARCH_INDEX=packages-index
AI_FOUNDRY_ENDPOINT=https://ai-YOUR-CLUSTER-NAME.openai.azure.com/
OPENAI_DEPLOYMENT=gpt-4o
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Azure Workload Identity (injected automatically by AKS — for reference only)
# ---------------------------------------------------------------------------
# AZURE_CLIENT_ID=           # Managed identity client ID
# AZURE_TENANT_ID=           # AAD tenant ID
# AZURE_FEDERATED_TOKEN_FILE=# Projected SA token path
