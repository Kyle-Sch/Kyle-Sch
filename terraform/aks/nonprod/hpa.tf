###############################################################################
# hpa.tf — HorizontalPodAutoscaler
###############################################################################

resource "kubernetes_horizontal_pod_autoscaler_v2" "fastapi" {
  metadata {
    name      = "fastapi-hpa"
    namespace = kubernetes_namespace.api.metadata[0].name
  }

  spec {
    scale_target_ref {
      api_version = "apps/v1"
      kind        = "Deployment"
      name        = kubernetes_deployment.fastapi.metadata[0].name
    }

    min_replicas = var.min_replicas
    max_replicas = var.max_replicas

    metric {
      type = "Resource"
      resource {
        name = "cpu"
        target {
          type                = "Utilization"
          average_utilization = 70
        }
      }
    }

    metric {
      type = "Resource"
      resource {
        name = "memory"
        target {
          type                = "Utilization"
          average_utilization = 80
        }
      }
    }
  }
}
